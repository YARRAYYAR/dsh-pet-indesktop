    def test_control_group_spawns_normally_without_session_end(tmp_path, monkeypatch):
        """对照组：未收到会话结束通知时，同一路径照常拉起（证明门是唯一差异）。
    
        与 test_webm_reader_lifecycle 同款：reader 线程会经 `_ensure_ffmpeg_exe`
